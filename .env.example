# Auto-wired by the template (do not set manually)
LISTMONK_db__host=${postgres.RAILWAY_PRIVATE_DOMAIN}
LISTMONK_db__password=${postgres.POSTGRES_PASSWORD}
POSTGRES_PASSWORD=${secret(32)}

# Handled automatically at boot by entrypoint.sh (not env vars — listmonk
# loads these from the DB settings table, which overrides env):
# - upload.filesystem.upload_path -> /data/uploads (Railway volume)
# - app.root_url -> https://${RAILWAY_PUBLIC_DOMAIN}

# Baked into the image (already set, listed for reference)
# LISTMONK_db__port=5432
# LISTMONK_db__user=listmonk
# LISTMONK_db__database=listmonk
# LISTMONK_db__ssl_mode=disable
# LISTMONK_upload__filesystem__upload_path=/data/uploads  (Railway volume)
# POSTGRES_USER=listmonk
# POSTGRES_DB=listmonk

# Optional — set AFTER deploy in the Railway dashboard if you want the
# superuser created without the web wizard (min 3 / 8 chars). If unset,
# the first visit to the web UI prompts you to create it.
# LISTMONK_ADMIN_USER=
# LISTMONK_ADMIN_PASSWORD=

# SMTP is configured in the web UI (Settings → SMTP) and stored in the
# database — it is not an env/config key in listmonk. No env needed on the
# deploy form for sending.
